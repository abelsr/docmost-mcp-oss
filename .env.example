# URL of your Docmost instance.
# - Self-hosted: the base of your installation, e.g. https://docmost.example.com
# - Cloud: includes your workspace's subdomain, e.g. https://mi-org.docmost.com
DOCMOST_URL=https://docmost.example.com

# --- Option A: API Key (requires an Enterprise license) ---
# The key is sent as `Authorization: Bearer <key>`.
DOCMOST_API_KEY=

# --- Option B: login with email/password (works on OSS) ---
# The server obtains the `authToken` cookie and reuses it.
DOCMOST_EMAIL=
DOCMOST_PASSWORD=

# HTTP timeout in seconds (optional, defaults to 30)
DOCMOST_TIMEOUT=30
